# The env contract. CI fails if code reads a variable not declared here.
# Values are placeholders; real values live in Vercel/Railway/GitHub Environments.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
# server-only; never shipped to the client; never in an agent's environment for prod
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_APP_URL=http://localhost:3000
SENTRY_DSN=
GIT_SHA=dev
