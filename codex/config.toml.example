# Project-level Codex config for a Blackadder app repo: copy to .codex/config.toml
# Codex reads AGENTS.md at the repo root automatically.

# Non-interactive runs use `codex exec` (approval policy "never"); keep the sandbox to the
# workspace so agents cannot reach production. Deploys happen from GitHub workflows only.
sandbox_mode = "workspace-write"
approval_policy = "on-request"

[agents]
enabled = true
max_concurrent_threads_per_session = 3

# Custom agents live in .codex/agents/*.toml (blackadder-acceptance-author, blackadder-builder,
# blackadder-verifier). Codex does not auto-spawn them; the /slice skill tells the main agent
# to delegate to them by name.
